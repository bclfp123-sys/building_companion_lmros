# --- MLOps Project-Specific Files ---
# Ignore MLflow's database and model artifacts.
# These are generated outputs, not source code, and will change constantly.
artifacts/
db/

# Ignore large, derived data files, but keep source data (like your PDF).
data/*.csv
data/*.parquet


# --- Python General ---
# Ignore byte-compiled files and cache folders.
__pycache__/
*.pyc
*.pyo
*.pyd


# --- Virtual Environments ---
# Never commit virtual environment folders.
.venv/
venv/
env/


# --- Jupyter Notebook ---
# Ignore notebook checkpoints.
.ipynb_checkpoints


# --- IDE & Operating System ---
# Ignore editor-specific settings and OS files.
.vscode/
.idea/
.DS_Store